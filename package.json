{
  "name": "qwen-mcp-server",
  "version": "0.2.0",
  "description": "MCP server for the Qwen Code CLI: ask, delegate and continue a conversation with Qwen Code from Claude Code, Codex, Cursor or any MCP client.",
  "main": "dist/index.js",
  "bin": {
    "qwen-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "pretest": "npm run build",
    "test": "jest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "qwen",
    "qwen-code",
    "claude-code",
    "codex",
    "cursor",
    "ai",
    "cli"
  ],
  "author": "Theralley (https://github.com/Theralley)",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "eslint": "^9.33.0",
    "jest": "^30.0.5",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Theralley/qwen-mcp-server.git"
  },
  "homepage": "https://github.com/Theralley/qwen-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/Theralley/qwen-mcp-server/issues"
  }
}
